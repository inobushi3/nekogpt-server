{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://nekogpt-server.vercel.app",
          "http://127.0.0.1:4173",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
